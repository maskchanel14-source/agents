# ─────────────────────────────────────────────────────────────
# AI VIRAL CLIP GENERATOR — environment template
# Copy to .env (never commit real secrets).
# ─────────────────────────────────────────────────────────────

ENV=development
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Data / database ──────────────────────────────────────────
# Local dev default (SQLite). Production: use Supabase Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/viralclips.db

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-64-char-random-string
JWT_TTL_HOURS=168
COOKIE_SECURE=false
# Supabase Auth (optional, for production): verifies Supabase-issued JWTs
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage ──────────────────────────────────────────────────
# local | r2
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=viral-clips
R2_PUBLIC_BASE_URL=

# ── Background jobs ──────────────────────────────────────────
# inline (dev, thread pool) | rq (Redis, production workers)
QUEUE_BACKEND=inline
REDIS_URL=redis://127.0.0.1:6379/0
JOB_MAX_WORKERS=1

# ── Transcription (ASR) ──────────────────────────────────────
# auto | openai | groq | faster_whisper | fixture | none
ASR_PROVIDER=auto
ASR_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=            # blank = auto detect (id/en supported)
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu

# ── LLM (viral moment detection) ─────────────────────────────
# auto | openai | anthropic | groq | gemini | ollama | heuristic
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_DEEP=gpt-4o
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3
LLM_MAX_OUTPUT_TOKENS=2000
VISION_ENABLED=false
VISION_MAX_FRAMES=12

# ── Media engine ─────────────────────────────────────────────
FFMPEG_BIN=
FFMPEG_THREADS=2
MAX_UPLOAD_MB=512
MAX_VIDEO_MINUTES=90
TEMP_TTL_HOURS=24
ENABLE_YOUTUBE_INGEST=false

# ── Frontend ─────────────────────────────────────────────────
# Browser-facing base URL is same-origin (/api, /media are proxied by Next.js).
INTERNAL_API_URL=http://127.0.0.1:8000
# Preview mode: skip the login wall and auto-sign into the seeded demo account.
# Leave empty in production. Used by apps/web/middleware.ts + /demo.
DEMO_MODE=
DEMO_EMAIL=demo@viralclips.example
DEMO_PASSWORD=demo-password-123
NEXT_PUBLIC_APP_NAME=AI Viral Clip Generator
