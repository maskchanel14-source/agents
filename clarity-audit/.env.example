# Public site URL (no trailing slash) — used for canonicals, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional Supabase persistence (server-side only). App runs fully without these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Payments + email are HUMAN-connected at launch. Do not commit real secrets.
