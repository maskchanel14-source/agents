# Salin ke .env (JANGAN di-commit). Bot mode paper TIDAK membutuhkan secret apa pun.
# Mode live: butuh LIVE_TRADING=true DAN file config/LIVE_CONFIRMED.txt (lihat README).
LIVE_TRADING=false

# Secret — hanya dibaca saat mode live. Jangan pernah ditulis ke repo, log, atau output.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=

# Gas estimate (opsional). Kosongkan untuk pakai fallback konservatif di config.
POLYGON_RPC_URL=
POL_USD_OVERRIDE=
