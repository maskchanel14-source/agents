# =============================================================
# .env.example — salin ke .env lalu isi. JANGAN commit .env!
# =============================================================

# --- Mode operasi (default: paper) ---
# Mode live HANYA aktif jika LIVE_TRADING=true DAN file live_trading.confirmed ada.
LIVE_TRADING=false

# --- Wallet (HANYA untuk mode live; jangan pernah commit nilai asli) ---
# Gunakan hot wallet khusus dengan saldo kecil, BUKAN wallet utama.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_SIGNER_ADDRESS=

# --- RPC Polygon (opsional, untuk estimasi gas & cek on-chain) ---
POLYGON_RPC_URL=

# --- Notifikasi (opsional, default OFF; jangan isi jika tidak dipakai) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Konfigurasi tambahan ---
# Override path config YAML (default: config/default.yaml)
BOT_CONFIG=
# Port dashboard (default 8788)
DASHBOARD_PORT=
