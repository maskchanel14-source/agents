# Placeholder-only example. Load these values into the agent harness environment.
# Do not commit a populated copy. The helper does not automatically load .env files.

SHOPIFY_SHOP=your-store
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=replace-with-secret-from-dev-dashboard
SHOPIFY_API_VERSION=2026-10
SHOPIFY_OPERATION_MODE=unrestricted

# Alternate authentication for an already-issued OAuth or legacy Admin API token.
# Remove SHOPIFY_CLIENT_ID and SHOPIFY_CLIENT_SECRET before using this variable.
# SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-an-already-issued-token
